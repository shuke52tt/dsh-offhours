{
  "name": "dsh-offhours",
  "version": "0.1.1",
  "description": "DSH 社区插件：把看板待办在低谷/夜间自动做掉（挑卡 → 独占 worktree → worker → 证据 → 合并回收），只依赖配置里的 git 仓库。",
  "type": "module",
  "license": "MIT",
  "main": "panel/index.js",
  "exports": {
    ".": "./panel/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "offhours": "./bin/offhours.mjs"
  },
  "files": [
    "bin/offhours.mjs",
    "lib/config.js",
    "lib/runtime.js",
    "lib/client.js",
    "panel/index.js",
    "panel/client.js",
    "panel/locale",
    "panel/icon.svg",
    "mechanism/scan.sh",
    "mechanism/ns.py",
    "mechanism/selftest.py",
    "feature-worktrees/feature",
    "feature-worktrees/feature-lib.sh",
    "feature-worktrees/feature-guard.sh",
    "feature-worktrees/selftest.sh",
    "skills/offhours/SKILL.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node scripts/gen-client.mjs",
    "gen:client": "node scripts/gen-client.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check panel/index.js && node --check lib/config.js && node --check lib/runtime.js && node --check bin/offhours.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "nightshift",
    "offhours",
    "batch",
    "kanban",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuke52tt/dsh-offhours.git"
  },
  "homepage": "https://github.com/shuke52tt/dsh-offhours#readme",
  "bugs": {
    "url": "https://github.com/shuke52tt/dsh-offhours/issues"
  }
}
